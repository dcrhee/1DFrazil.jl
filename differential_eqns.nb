Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "your", " ", "matrix"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"mat", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"F1", ",", "0", ",", " ", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"F2", ",", "F3", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "F4", ",", " ", "0"}], "}"}]}], "}"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Use", " ", "Eigensystem", " ", "to", " ", "get", " ", "eigenvalues", " ",
      "and", " ", "eigenvectors"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eigenvalues", ",", "eigenvectors"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", "mat", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Construct", " ", "the", " ", "diagonal", " ", "matrix", " ", "from", " ",
      "eigenvalues"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Diag", "=", 
     RowBox[{"DiagonalMatrix", "[", "eigenvalues", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Normalize", " ", "each", " ", "eigenvector"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"normalizedEigenvectors", "=", 
     RowBox[{"Normalize", "/@", "eigenvectors"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Construct", " ", "the", " ", "transformation", " ", "matrix", " ", 
     "from", " ", "eigenvectors"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P", "=", 
     RowBox[{"Transpose", "[", "normalizedEigenvectors", "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Verify", " ", "the", " ", 
      RowBox[{"diagonalization", ":", 
       RowBox[{
        RowBox[{"P", "^", 
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}]}], "*", "matrix", "*", "P"}]}]}], "=", 
     "D"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Inverse", "[", "P", "]"}], ".", "mat", ".", "matrix", ".", 
     "P"}], "//", "FullSimplify"}]}]}]], "Input",
